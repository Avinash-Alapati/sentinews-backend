# ==============================================================================
# SentiNews Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development or configure in AWS Secrets Manager.
# DO NOT COMMIT PRODUCTION SECRETS TO GIT.

# =====================================
# Application Core
# =====================================
ENVIRONMENT="development"
PROJECT_NAME="SentiNews API"
API_V1_STR="/api/v1"
LOG_LEVEL="INFO"
WEB_CONCURRENCY=2
PORT=8000
FETCHER_MODE="inprocess"  # "inprocess" (leader election) or "worker" (Celery/APScheduler)
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:3001","http://localhost:3002"]

# =====================================
# Database (PostgreSQL)
# =====================================
# Production: RDS PostgreSQL in private VPC subnets
# Local: postgres service from docker-compose
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/sentinews"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinews"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10

# =====================================
# Redis & Cache (AWS ElastiCache / Local Redis)
# =====================================
# Local dev: redis://localhost:6379/0 or redis://redis:6379/0
# Production: rediss://:AUTH_TOKEN@clustercfg.sentinews-redis.xxxx.aps1.cache.amazonaws.com:6379/0
REDIS_URL="redis://localhost:6379/0"
REDIS_ENABLED=true
REDIS_TIMEOUT=1.5
REDIS_TLS_ENABLED=false
REDIS_SSL_CERT_REQS="none"  # "none", "optional", "required"
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_SOCKET_KEEPALIVE=true
REDIS_RETRY_ON_TIMEOUT=true
REDIS_MAX_CONNECTIONS=50

# Cache Soft/Hard TTLs (Seconds)
CACHE_TTL=300
QUOTE_CACHE_TTL=30
MARKET_OVERVIEW_SOFT_TTL=30
MARKET_OVERVIEW_HARD_TTL=1800
INDICES_SOFT_TTL=30
INDICES_HARD_TTL=1800
QUOTE_SOFT_TTL=30
QUOTE_HARD_TTL=1800
CANDLES_SOFT_TTL=300
CANDLES_HARD_TTL=7200
SEARCH_SOFT_TTL=3600
SEARCH_HARD_TTL=86400
ETFS_SOFT_TTL=300
ETFS_HARD_TTL=3600
CACHE_SOFT_TTL_JITTER_PCT=0.15

# =====================================
# Celery Workers & Schedulers
# =====================================
CELERY_CONCURRENCY=4

# =====================================
# Authentication & Security
# =====================================
SECRET_KEY="your_super_secret_jwt_key_here_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_REFRESH_MODE="body"  # "body" (cross-domain) or "cookie" (same-domain)

# Google OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
GOOGLE_REDIRECT_URI_ALLOWLIST=["http://localhost:8000/api/v1/auth/google/callback","http://localhost:5173/auth/callback","http://localhost:3000/auth/callback"]

# =====================================
# Market Data Providers
# =====================================
MARKET_PROVIDER="yahoo"
MARKET_FALLBACK_PROVIDER="upstox"
MARKET_LATENCY_THRESHOLD_SECONDS=4.0
MARKET_ENABLE_LATENCY_FALLBACK=true

# Upstox API (Indian Markets - NSE / BSE)
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
UPSTOX_REDIRECT_URI="http://localhost:3001/api/auth/callback/upstox"
UPSTOX_ACCESS_TOKEN=""

# Global Market Providers (Optional)
FINNHUB_API_KEY=""
ALPHAVANTAGE_API_KEY=""
TWELVEDATA_API_KEY=""

# =====================================
# News APIs
# =====================================
STOCKNEWS_API_KEY=""
NEWSAPI_API_KEY=""
GNEWS_API_KEY=""

# =====================================
# AI Models (Sentiment & Summarization)
# =====================================
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

# =====================================
# Multi-Tier Rate Limiting
# =====================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_OAUTH_PER_MINUTE=10
RATE_LIMIT_NEWS_CLICK_PER_MINUTE=60
RATE_LIMIT_HEAVY_COMPUTE_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# =====================================
# APM & Observability
# =====================================
APM_ENABLED=true
METRICS_TOKEN="sentinews_metrics_secret_token"
SERVICE_NAME="sentinews-api"
ENV="development"
APP_MEMORY_LIMIT_BYTES=536870912
LOKI_URL="http://loki:3100"
SENTRY_DSN=""
PROMETHEUS_MULTIPROC_DIR="/tmp/prometheus_multiproc"
SHUTDOWN_MARKER_FILE="/tmp/.sentinews_clean_shutdown"
